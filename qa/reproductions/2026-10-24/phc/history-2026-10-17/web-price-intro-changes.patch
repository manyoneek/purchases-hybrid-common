+  describe('QA public currency-unit contract', () => {
+    it.each(['Week', 'Month', 'Year'])('maps pricePer%s to major currency units', period => {
+      const pkg = createPackage('qa', 'qa', PackageType.Monthly);
+      const offering = {identifier: 'qa', serverDescription: 'qa', availablePackages: [pkg]} as Offering;
+      const result = mapOfferings({all: {qa: offering}, current: offering});
+      const mapped = (result.current as any).availablePackages[0].product;
+      const input = (pkg.webBillingProduct.defaultSubscriptionOption!.base as any)['pricePer' + period];
+      expect(mapped['pricePer' + period]).toBe(input.amountMicros / 1_000_000);
+      expect(mapped['pricePer' + period + 'String']).toBe(input.formattedPrice);
+    });
+    it('preserves null period prices on lifetime products', () => {
+      const pkg = createPackage('qa', 'qa', PackageType.Lifetime);
+      const offering = {identifier: 'qa', serverDescription: 'qa', availablePackages: [pkg]} as Offering;
+      const result = mapOfferings({all: {qa: offering}, current: offering});
+      const mapped = (result.current as any).availablePackages[0].product;
+      for (const period of ['Week', 'Month', 'Year']) expect(mapped['pricePer' + period]).toBeNull();
+    });
